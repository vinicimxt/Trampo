@model ErrorViewModel
@{
    ViewData["Title"] = "Não foi possível concluir a solicitação";
}

<section class="container-ap" style="max-width: 700px; padding: 5rem 1rem; text-align: center;">
    <span class="material-symbols-rounded" aria-hidden="true" style="font-size: 3rem; color: #b45309;">error</span>
    <h1>Não foi possível concluir a solicitação</h1>
    <p role="alert">Ocorreu um erro inesperado. Tente novamente.</p>

@if (Model.ShowRequestId)
{
    <p>
        Referência: <code>@Model.RequestId</code>
    </p>
}

    <a href="/" class="btn btn-primary">Voltar ao início</a>
</section>
